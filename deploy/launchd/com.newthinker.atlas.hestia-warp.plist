<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- com.newthinker.atlas.hestia-warp —— 每 30 分钟跑一次 scripts/ops/hestia-warp-trigger.sh：
     队列里有活才唤起 Warp 解读 agent（先判后唤起的理由见该脚本头注释）。
     真相源在本仓库 deploy/launchd/，由 scripts/ops/install-services.sh 复制到 ~/Library/LaunchAgents/。

     ⚠️ **代理键在这里是必须的**：脚本经 `pnpm run chat` 唤起 nanoclaw，容器里的 agent
     要出网访问 Anthropic，而 launchd 不继承登录 shell 的环境 —— 不设就恒连不上。
     这一点与 hestia-ingest.plist 相同：那份也设了 http_proxy / https_proxy / no_proxy
     （给 M2b 的 Sheets 投影出网，5447d05 起；守卫 cmd/atlas/hestia_test.go 的
     TestHestiaPlistSetsProxyKeysForSheets）。hestia 抓央行仍是直连，那由
     internal/hestia/fetch.go 的空 Transport{}（Proxy 留零值）保证，与 plist 无关。

     🔴 **别照抄 crisis / refresh-cnhk / prism-daily 的 plist**：三份的 EnvironmentVariables
     彼此都不一样（crisis-daily 里 no_proxy 与两个代理键之间隔着 PATH；
     prism-daily 根本没有 PATH），「照抄再改」容易漏改或多带。本文件的键照计划原文写，
     不是抄来的。

     PATH 首段是 nvm 的 node v22 bin 目录（pnpm 在那里），因为 launchd 不继承登录 shell 的 PATH。
     ⚠️ 写死版本号是有代价的——nvm 升级、该目录消失后会**静默失效**：stderr 出现
     `pnpm: command not found`，但触发脚本对唤起用了 `|| true`，**退出码仍是 0**，
     launchd 也不会告诉你。所以上线验收要真的等一次自动唤起并看到笔记产出
     （计划验收判据五），而不是只看退出码或手工跑一遍脚本。 -->
<dict>
  <key>Label</key>
  <string>com.newthinker.atlas.hestia-warp</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zuowei/workspace/runtime/atlas/scripts/ops/hestia-warp-trigger.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/zuowei/workspace/runtime/atlas</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/zuowei/.nvm/versions/node/v22.22.0/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>http_proxy</key>
    <string>http://127.0.0.1:7897</string>
    <key>https_proxy</key>
    <string>http://127.0.0.1:7897</string>
    <key>no_proxy</key>
    <string>localhost,127.0.0.1</string>
  </dict>

  <!-- 每 30 分钟，从加载时刻起算，不对齐日历格（同 analysis / crisis-intraday-jpy 的做法）。
       processing/ 空闲时，入队的契约最多等一轮（30 分钟）就会被唤起处理；
       队列空时一轮的成本是对 pending/ 与 processing/ 各一次 find，密一点也无妨。 -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <!-- 加载时不立即跑：装服务不该顺带唤起一个 agent。 -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/zuowei/workspace/runtime/atlas/logs/hestia-warp.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zuowei/workspace/runtime/atlas/logs/hestia-warp.err.log</string>
</dict>
</plist>
