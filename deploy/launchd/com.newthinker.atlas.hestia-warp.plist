<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- com.newthinker.atlas.hestia-warp —— 每 30 分钟跑一次 scripts/ops/hestia-warp-trigger.sh：
     队列里有活才唤起 Warp 解读 agent（先判后唤起的理由见该脚本头注释）。
     真相源在本仓库 deploy/launchd/，由 scripts/ops/install-services.sh 复制到 ~/Library/LaunchAgents/。

     ⚠️ **代理键在这里是必须的**：本任务调的是 nanoclaw，容器里的 agent 要出网访问
     Anthropic，而 launchd 不继承登录 shell 的环境 —— 不设就恒连不上。
     hestia-ingest.plist 同样设了这三个键（给 Sheets 投影出网，5447d05 起；守卫
     cmd/atlas/hestia_test.go 的 TestHestiaPlistSetsProxyKeysForSheets），两份需要代理的
     理由各自独立。⚠️ 那份文件头注释里「一个代理键都没有」是过期说法，以其
     EnvironmentVariables 里的注释为准。

     🔴 **别照抄 crisis / refresh-cnhk / prism-daily 的 plist**：三份里 no_proxy 的
     位置各不相同，「照抄再改」在前者会漏、在后者会过头（成因见 hestia-ingest.plist
     的头注释）。本文件的键是照计划原文写的，不是抄来的。

     PATH 要含 nvm 的 node：pnpm 走 node v22，而 launchd 不继承登录 shell 的 PATH。
     ⚠️ 写死版本号是有代价的——nvm 升级后这里会悄悄失效（脚本报 command not found、
     退出码非零、而 launchd 默认不会告诉你）。所以上线验收要真的等一次自动唤起
     （计划验收判据五），而不是只手工跑一遍脚本。 -->
<dict>
  <key>Label</key>
  <string>com.newthinker.atlas.hestia-warp</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zuowei/workspace/runtime/atlas/scripts/ops/hestia-warp-trigger.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/zuowei/workspace/runtime/atlas</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/zuowei/.nvm/versions/node/v22.22.0/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>http_proxy</key>
    <string>http://127.0.0.1:7897</string>
    <key>https_proxy</key>
    <string>http://127.0.0.1:7897</string>
    <key>no_proxy</key>
    <string>localhost,127.0.0.1</string>
  </dict>

  <!-- 每 30 分钟，从加载时刻起算。用 StartInterval 而非 StartCalendarInterval：
       它不对齐日历格，因此与既有八个日历时刻都不冲突（同 analysis / crisis-intraday-jpy）。
       30 分钟的依据：ingest 在 15:30 / 17:30 / 21:30，半小时内必然跟上；而队列空时
       本脚本的成本是一次 find，密一点也无妨。 -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <!-- 加载时不立即跑：装服务不该顺带唤起一个 agent。 -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/zuowei/workspace/runtime/atlas/logs/hestia-warp.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zuowei/workspace/runtime/atlas/logs/hestia-warp.err.log</string>
</dict>
</plist>
