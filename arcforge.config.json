{
  "coverage": {
    "dev_scope": "changed-package",
    "dev_minimum": 80,
    "final_minimum": 80,
    "tool": "auto",
    "report_dir": ".arcforge/coverage",
    "test_timeout": "120s"
  },
  "autonomy": "dod-gate",
  "max_rework": 3,
  "scheduling": "dag",
  "team": {
    "max_dev_agents": 4,
    "max_test_agents": 2,
    "max_qa_agents": 1,
    "models": {
      "dev": "inherit",
      "test": "inherit",
      "qa": "inherit",
      "ops": "inherit"
    }
  },
  "tdd": {
    "strict": true,
    "require_failing_test_first": true,
    "require_all_tests_pass": true
  },
  "code_review": {
    "enabled": true,
    "max_iterations": 3,
    "severity_threshold": "warning",
    "adversarial": {
      "perspective_review": true,
      "cross_model": "auto"
    }
  },
  "language": "go",
  "test_command": "go test ./... -v -coverprofile=coverage.out",
  "coverage_command": "go tool cover -func=coverage.out",
  "capabilities": {
    "ecc": false,
    "superpowers": true,
    "codex_cli": true,
    "gemini_cli": false,
    "write_guard": true,
    "validator_bin": "~/.arcforge/bin",
    "detected_at": "2026-07-17T10:05:00+08:00"
  },
  "arcforge": {
    "repo": "https://github.com/newthinker/ArcForge.git",
    "auto_update_check": true
  },
  "jev": {
    "enabled": true,
    "model": "jev-1.13.0",
    "api_key_env": "TYPESAFE_API_KEY",
    "allowed_projects": [
      "newthinker/atlas"
    ],
    "quality_gate": {
      "mode": "shadow",
      "timeout_s": 15,
      "max_diff_bytes": 60000,
      "dod_filter": {
        "max_chars": 200,
        "max_semicolons": 1
      },
      "thresholds": {
        "pass_min": 0.90,
        "fail_max": 0.70,
        "verdict_pass_conf": 0.60,
        "clear_fail_conf": 0.70,
        "integrity_max": 0.80
      }
    }
  }
}
