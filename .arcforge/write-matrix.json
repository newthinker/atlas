{
  "version": 1,
  "tokens": {
    "dev-m4-a": "dba9044517555f6eb064cacb4fbaa268dc7f877141ca7b34509b133f48db262b",
    "dev-m4-b": "72bde9dc8434edcf4a28785f6497a9030defbee499a85019604438634498e9dd",
    "dev-m4-c": "621d8791a921349ae34a64eb847e4ac8874e63503a7fa861c9fc3a6982370de8",
    "test-m4-a": "cc632aa31627b916a85672ed83c0f4fc87c33edf030139b3fe96fdd933ccded3",
    "test-m4-b": "df5d0d9cfdfd4a2697fc3a3e3be541398b4c260d4f350f11b656246b61acdeef",
    "qa-m4-a": "d363375d14f946146ef898a1a7d09c5c9c6e4d3e65b01358fd025b616c549b64"
  },
  "instances": "^(leader|dev-[a-z0-9-]+|test-[a-z0-9-]+|qa-[a-z0-9-]+|ops-[a-z0-9-]+)$",
  "rules": [
    {
      "path": "tasks/TASK-*.json",
      "writers": "owner-table"
    },
    {
      "path": "docs/01-design/*",
      "writers": [
        "leader"
      ]
    },
    {
      "path": "docs/02-plan/*",
      "writers": [
        "leader"
      ]
    },
    {
      "path": "docs/03-progress/plan.md",
      "writers": [
        "leader"
      ]
    },
    {
      "path": "docs/04-test/*",
      "writers": [
        "test-*"
      ]
    },
    {
      "path": "docs/05-review/*",
      "writers": [
        "qa-*"
      ]
    },
    {
      "path": "docs/06-acceptance/*",
      "writers": [
        "leader"
      ]
    },
    {
      "path": "docs/07-deploy/*",
      "writers": [
        "ops-*"
      ]
    },
    {
      "path": "discoveries/TASK-*.json",
      "writers": "task-owner"
    },
    {
      "path": "wisdom/learnings-{me}.md",
      "writers": "self"
    },
    {
      "path": "wisdom/decisions-{me}.md",
      "writers": "self"
    },
    {
      "path": "wisdom/_digest.md",
      "writers": [
        "leader"
      ]
    },
    {
      "path": "checkpoints/{me}*",
      "writers": "self"
    }
  ],
  "owner_table": {
    "pending": [
      "leader"
    ],
    "assigned": [
      "leader"
    ],
    "in_progress": [
      "dev-*"
    ],
    "dev_done": [
      "dev-*"
    ],
    "verifying": [
      "test-*"
    ],
    "verified": [
      "test-*"
    ],
    "rejected": [
      "test-*"
    ],
    "review_fix": [
      "leader"
    ],
    "accepted": [
      "leader"
    ],
    "skipped": [
      "leader"
    ],
    "blocked_clarification": [
      "leader",
      "dev-*"
    ],
    "blocked_human": [
      "leader"
    ]
  },
  "transitions": {
    "pending->assigned": [
      "leader"
    ],
    "assigned->in_progress": [
      "dev-*"
    ],
    "in_progress->dev_done": [
      "dev-*"
    ],
    "in_progress->blocked_clarification": [
      "dev-*"
    ],
    "blocked_clarification->in_progress": [
      "dev-*"
    ],
    "blocked_clarification->blocked_human": [
      "leader"
    ],
    "blocked_human->assigned": [
      "leader"
    ],
    "blocked_human->skipped": [
      "leader"
    ],
    "dev_done->verifying": [
      "leader"
    ],
    "verifying->verified": [
      "test-*"
    ],
    "verifying->rejected": [
      "test-*"
    ],
    "rejected->assigned": [
      "leader"
    ],
    "assigned->assigned": [
      "leader"
    ],
    "in_progress->assigned": [
      "leader"
    ],
    "rejected->blocked_human": [
      "leader"
    ],
    "verified->review_fix": [
      "leader"
    ],
    "review_fix->in_progress": [
      "dev-*"
    ],
    "verified->accepted": [
      "leader"
    ],
    "pending->skipped": [
      "leader"
    ],
    "assigned->skipped": [
      "leader"
    ],
    "verifying->verifying": [
      "leader"
    ],
    "review_fix->assigned": [
      "leader"
    ]
  },
  "bindings": {
    "dev-*": "assigned_to",
    "test-*": "verifier"
  }
}
