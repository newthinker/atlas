  "instances": "^(leader|dev-[a-z0-9-]+|test-[a-z0-9-]+|qa-[a-z0-9-]+|ops-[a-z0-9-]+)$",
  "rules": [
    {
      "path": "tasks/TASK-*.json",
      "writers": "owner-table"
    },
    {
      "path": "docs/01-design/*",
      "writers": [
        "leader"
      ]
    },
    {
      "path": "docs/02-plan/*",
      "writers": [
        "leader"
      ]
    },
    {
      "path": "docs/03-progress/plan.md",
      "writers": [
        "leader"
      ]
    },
    {
      "path": "docs/04-test/*",
      "writers": [
        "test-*"
      ]
    },
    {
      "path": "docs/05-review/*",
      "writers": [
        "qa-*"
      ]
    },
    {
      "path": "docs/06-acceptance/*",
      "writers": [
        "leader"
      ]
    },
    {
      "path": "docs/07-deploy/*",
      "writers": [
        "ops-*"
      ]
    },
    {
      "path": "discoveries/TASK-*.json",
      "writers": "task-owner"
    },
    {
      "path": "wisdom/learnings-{me}.md",
      "writers": "self"
    },
    {
      "path": "wisdom/decisions-{me}.md",
      "writers": "self"
    },
    {
      "path": "wisdom/_digest.md",
      "writers": [
        "leader"
      ]
    },
    {
      "path": "checkpoints/{me}*",
      "writers": "self"
    }
  ],
