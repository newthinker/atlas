<?xml version="1.0" encoding="utf-8"?>
<!--
  次年同期的 10-Q:它把 2026-01-01~2026-03-31 作为**去年同季**再次披露,且数值被重述
  (34.681B → 34.999B)。用于检验「同 (period, member) 跨报告重复出现时取 FilingDate 更晚者」。
  在 submissions 里这份报告排在前面(SEC 按 filingDate 倒序),因此「按处理顺序后者胜」的实现
  会取到旧值 34.681B —— 只有真正比较 FilingDate 才能得到 34.999B。
-->
<xbrl
  xmlns="http://www.xbrl.org/2003/instance"
  xmlns:iso4217="http://www.xbrl.org/2003/iso4217"
  xmlns:msft="http://www.microsoft.com/20270331"
  xmlns:us-gaap="http://fasb.org/us-gaap/2025"
  xmlns:xbrldi="http://xbrl.org/2006/xbrldi">

  <unit id="U_USD"><measure>iso4217:USD</measure></unit>

  <!-- 去年同季(被重述) -->
  <context id="C_prior_ic">
    <entity><identifier scheme="http://www.sec.gov/CIK">0000789019</identifier>
      <segment><xbrldi:explicitMember dimension="us-gaap:StatementBusinessSegmentsAxis">msft:IntelligentCloudMember</xbrldi:explicitMember></segment>
    </entity>
    <period><startDate>2026-01-01</startDate><endDate>2026-03-31</endDate></period>
  </context>
  <us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax contextRef="C_prior_ic" unitRef="U_USD" decimals="-6">34999000000</us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax>

  <!-- 本季 -->
  <context id="C_cur_ic">
    <entity><identifier scheme="http://www.sec.gov/CIK">0000789019</identifier>
      <segment><xbrldi:explicitMember dimension="us-gaap:StatementBusinessSegmentsAxis">msft:IntelligentCloudMember</xbrldi:explicitMember></segment>
    </entity>
    <period><startDate>2027-01-01</startDate><endDate>2027-03-31</endDate></period>
  </context>
  <us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax contextRef="C_cur_ic" unitRef="U_USD" decimals="-6">41000000000</us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax>
</xbrl>
